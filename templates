<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CJH Panel - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0b0f19; color: #e2e8f0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; color: white; }
        .btn-custom { background: linear-gradient(135deg, #238636, #1f6feb); color: white; border: none; font-weight: 600; }
        .btn-custom:hover { opacity: 0.9; color: white; }
        .form-control { background-color: #0d1117; color: white; border: 1px solid #30363d; }
        .form-control:focus { background-color: #0d1117; color: white; }
    </style>
</head>
<body class="p-4">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
            <h2>⚡ CJH Control Panel</h2>
            <div>
                <span class="me-3">User: <strong>{{ user }}</strong> ({{ role }})</span>
                <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Discord Bot Hosting Section -->
            <div class="col-md-6">
                <div class="card p-4">
                    <h4>🤖 Discord Bot Hosting</h4>
                    <form action="/add-bot" method="POST" class="mt-3">
                        <div class="mb-3">
                            <input type="text" name="name" class="form-control" placeholder="Bot Name" required>
                        </div>
                        <div class="mb-3">
                            <input type="text" name="cmd" class="form-control" placeholder="Start Command (e.g. python3 bot.py)" required>
                        </div>
                        <button type="submit" class="btn btn-custom w-100">Host Bot</button>
                    </form>

                    <h5 class="mt-4">Active Bots</h5>
                    <ul class="list-group list-group-flush mt-2">
                        {% for bot in bots %}
                            <li class="list-group-item bg-dark text-white d-flex justify-content-between align-items-center border-secondary">
                                {{ bot.name }} <span class="badge bg-success">{{ bot.status }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item bg-dark text-muted border-secondary">No bots deployed yet.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <!-- KVM VPS Management Section -->
            <div class="col-md-6">
                <div class="card p-4">
                    <h4>💻 KVM VPS Manager</h4>
                    {% if role == 'admin' %}
                    <form action="/create-vps" method="POST" class="mt-3">
                        <div class="mb-3">
                            <input type="text" name="vps_name" class="form-control" placeholder="VPS Instance Name" required>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <input type="number" name="ram" class="form-control" placeholder="RAM (MB)" required>
                            </div>
                            <div class="col">
                                <input type="number" name="vcpu" class="form-control" placeholder="vCPU Cores" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Create VPS Instance</button>
                    </form>
                    {% else %}
                    <p class="text-muted mt-2">VPS Creation is only available for Admins.</p>
                    {% endif %}

                    <h5 class="mt-4">Active VPS Servers</h5>
                    <ul class="list-group list-group-flush mt-2">
                        {% for vps in vps_list %}
                            <li class="list-group-item bg-dark text-white d-flex justify-content-between align-items-center border-secondary">
                                {{ vps.name }} ({{ vps.ram }}MB / {{ vps.vcpu }} Core)
                                <span class="badge bg-info">{{ vps.status }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item bg-dark text-muted border-secondary">No VPS running.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
